# Copy to .env and adjust values. Use Node 22: `nvm use 22`

# Host machine (npm run dev) with Postgres in Docker on port 5432:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_foundation"
# Note: `docker compose up` for the full stack overrides DATABASE_URL inside the API
# container to use hostname `postgres` (see docker-compose.yml).

# Minimum 32 characters each; use long random strings in real deployments
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-ch!!"

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
PASSWORD_RESET_TTL_SEC=3600

PORT=3000
NODE_ENV=development

# When true, forgot-password response includes resetToken (use only for local/testing)
# In production with false, the token is only logged server-side once
PASSWORD_RESET_RETURN_TOKEN=false

# Optional: comma-separated origins, or * for any origin (not recommended in production)
# CORS_ORIGIN=http://localhost:5173
